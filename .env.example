# Application
APP_NAME=MyDenning
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://mydenning:mydenning@localhost:5432/mydenning
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=mydenning

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# S3 Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=mydenning-documents
S3_REGION=us-east-1

# Anthropic API
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Sentence Transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# JWT Auth
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OCR
TESSERACT_CMD=/usr/bin/tesseract

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# External Legal Source API Keys (all optional — adapters degrade gracefully without them)
COURTLISTENER_API_TOKEN=    # Free: register at courtlistener.com/sign-in/
LAWS_AFRICA_API_TOKEN=      # Free: register at edit.laws.africa (20+ African countries)
CANLII_API_KEY=             # Free: register at developer.canlii.org
INDIAN_KANOON_API_KEY=      # Apply at indiankanoon.org/api/
